{
  "buildCommand": "bash build-merged.sh",
  "outputDirectory": "dist-business",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/admin/index\\.html$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/admin/?(.*)$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/index.html"
    },
    {
      "src": "^/business\\.html$",
      "dest": "/business.html"
    },
    {
      "src": "^/logo\\.(png|jpeg|jpg|svg|ico)$",
      "dest": "/logo.$1"
    },
    {
      "src": "^/admin/assets/(.*)$",
      "dest": "/admin/assets/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^(?!.*(\\.(js|css|svg|png|jpg|jpeg|gif|webp|ico|json|map)$))/.*",
      "dest": "/business.html"
    }
  ]
}
