{
  "buildCommand": "bash build-merged.sh",
  "outputDirectory": "dist-business",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/api/route-handler$",
      "dest": "/api/route-handler.ts"
    },
    {
      "src": "^/logo\\.(png|jpeg|jpg|svg|ico)$",
      "dest": "/logo.$1"
    },
    {
      "src": "^/admin/assets/(.*)$",
      "dest": "/admin/assets/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/admin/firebase-messaging-sw\\.js$",
      "dest": "/admin/firebase-messaging-sw.js"
    },
    {
      "src": "^/firebase-messaging-sw\\.js$",
      "dest": "/firebase-messaging-sw.js"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/api/route-handler.ts"
    },
    {
      "src": "^/(?!admin).*$",
      "dest": "/api/route-handler.ts"
    }
  ]
}
