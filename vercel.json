{
  "buildCommand": "npm run build:business && npm run build:admin && node scripts/merge-builds.mjs",
  "outputDirectory": "dist-business",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/admin/assets/(.*)$",
      "dest": "/admin/assets/$1"
    },
    {
      "src": "^/firebase-messaging-sw\\.js$",
      "dest": "/firebase-messaging-sw.js"
    },
    {
      "src": "^/logo\\.(png|jpeg|jpg|svg|ico)$",
      "dest": "/logo.$1"
    },
    {
      "src": "^/favicon\\.svg$",
      "dest": "/favicon.svg"
    },
    {
      "src": "^/business\\.html$",
      "dest": "/business.html"
    },
    {
      "src": "^/admin\\.html$",
      "dest": "/admin.html"
    },
    {
      "src": "^/router\\.html$",
      "dest": "/router.html"
    },
    {
      "src": "^/.*$",
      "dest": "/router.html"
    }
  ]
}
