{
  "buildCommand": "npm run build:admin",
  "outputDirectory": "dist-admin",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/firebase-messaging-sw\\.js$",
      "dest": "/firebase-messaging-sw.js"
    },
    {
      "src": "^/logo\\.(png|jpeg|jpg|svg|ico)$",
      "dest": "/logo.$1"
    },
    {
      "src": "^/.*$",
      "dest": "/admin.html"
    }
  ]
}
