# Vercel Ignore File
# Files and directories to exclude from Vercel deployments

# Version control
.git
.gitignore
.github

# Dependencies (installed by Vercel)
node_modules

# Local development
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage
.nyc_output
.pytest_cache
playwright-report
test-results

# Build artifacts (not needed after build)
dist
dist-admin

# Logs
*.log
npm-debug.log*

# Documentation (optional)
docs
guidelines
examples

# Database dumps
scripts/mysql-export

# E2E tests source (tests run locally, not on Vercel)
e2e
playwright-report

# Backup files
*.bak
*.backup

# Temporary files
.tmp
temp

# Note: Keep these files:
# - src/ (used by build)
# - vercel/ (contains middleware)
# - public/ (static assets)
# - scripts/ (build scripts)
# - package.json, package-lock.json
# - vite configs
# - tsconfig.json
